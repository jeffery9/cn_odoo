<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <!-- Report Line Template -->
    <t t-name="financial_report_viewer.ReportLineComponent" owl="1">
        <tr t-att-class="line.action_ids[0] ? 'o_row_clickable' : ''">
            <td>
                <span t-att-style="'padding-left: ' + (20 * (line.get('level', 0))) + 'px;'">
                    <i t-if="line.children &amp;&amp; line.children.length > 0" 
                       class="fa me-2" 
                       t-att-class="state.isFolded ? 'fa-caret-right' : 'fa-caret-down'" 
                       t-on-click.stop="toggleFold"/>
                    <t t-esc="line.name"/>
                </span>
            </td>
            <t t-foreach="line.balances" t-as="balance" t-key="$index">
                <td class="text-end" t-on-click="() => props.onLineClick(line.action_ids[$index])">
                    <t t-esc="balance"/>
                </td>
            </t>
        </tr>
        <t t-if="!state.isFolded">
            <t t-foreach="line.children" t-as="child_line" t-key="child_line.name">
                <ReportLineComponent line="child_line" onLineClick="props.onLineClick"/>
            </t>
        </t>
    </t>

    <!-- Main Report Viewer Template -->
    <t t-name="financial_report_viewer.FinancialReportViewer" owl="1">
        <div class="o_financial_report_viewer">
            <div class="o_control_panel d-flex justify-content-between p-3">
                <h1><t t-esc="state.title"/></h1>
                <div class="o_cp_right d-flex">
                    <div class="o_cp_item ms-3">
                        <button class="btn btn-primary" t-on-click="exportPDF">Export PDF</button>
                        <button class="btn btn-secondary" t-on-click="exportExcel">Export Excel</button>
                        <button class="btn btn-warning text-white" t-on-click="toggleSankey">Sankey View (桑基图)</button>
                    </div>
                    <div class="o_cp_item ms-3">
                        <button class="btn btn-info" t-on-click="addPeriod">Add Period</button>
                    </div>
                    <div class="o_cp_item ms-3 d-flex flex-column">
                        <t t-foreach="state.periods" t-as="period" t-key="period.id">
                            <div class="d-flex align-items-center mb-1">
                                <label class="me-2">From:</label>
                                <input type="date" class="o_input me-2" t-on-change="(ev) => onPeriodDateChange(period.id, 'date_from', ev.target.value)" t-att-value="period.date_from"/>
                                <label class="me-2">To:</label>
                                <input type="date" class="o_input me-2" t-on-change="(ev) => onPeriodDateChange(period.id, 'date_to', ev.target.value)" t-att-value="period.date_to"/>
                                <button class="btn btn-danger btn-sm" t-on-click="() => removePeriod(period.id)">X</button>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
            <div class="o_content">
                <!-- Interactive Sankey Diagram Visualization -->
                <div t-if="state.showSankey" class="o_sankey_view p-3 mb-4 bg-white border rounded shadow-sm">
                    <h3 class="text-center mb-3 text-primary font-weight-bold">
                        财务指标流动与利益分配透视 (Sankey Diagram)
                    </h3>
                    <t t-if="getSankeyData().hasData">
                        <div class="d-flex justify-content-center">
                            <svg width="900" height="450" class="border bg-light rounded" style="font-family: inherit;">
                                <!-- Render flow links -->
                                <g>
                                    <t t-foreach="getSankeyData().links" t-as="link" t-key="link.path">
                                        <path t-att-d="link.path" t-att-fill="link.color" class="o_sankey_link" style="transition: fill 0.2s, opacity 0.2s; opacity: 0.85;">
                                            <title><t t-esc="link.label"/>: <t t-esc="link.value"/> 元</title>
                                        </path>
                                    </t>
                                </g>
                                <!-- Render nodes -->
                                <g>
                                    <t t-foreach="getSankeyData().nodes" t-as="node" t-key="node.id">
                                        <rect t-att-x="node.x" t-att-y="node.y" t-att-width="node.w" t-att-height="node.h" t-att-fill="node.color" rx="4" class="o_sankey_node" style="stroke: #fff; stroke-width: 1px;"/>
                                        <!-- Node labels -->
                                        <text t-att-x="node.x &lt; 400 ? (node.x - 12) : (node.x + node.w + 12)" 
                                              t-att-y="node.y + node.h / 2 + 4" 
                                              t-att-text-anchor="node.x &lt; 400 ? 'end' : 'start'" 
                                              font-size="11" font-weight="bold" fill="#333">
                                            <t t-esc="node.label"/> (<t t-esc="node.formattedValue"/>)
                                        </text>
                                    </t>
                                </g>
                            </svg>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="alert alert-info text-center p-5 m-3" role="alert">
                            <i class="fa fa-info-circle fa-2x mb-3 text-muted"></i>
                            <div><strong>暂无当期账务发生额！</strong></div>
                            <p class="text-muted mt-2">系统当前账期下无营业收入、成本或期间费用发生额。请选择有账务过账记录的会计期间，以展示动态桑基流向分析。</p>
                        </div>
                    </t>
                </div>

                <table class="o_list_view table table-sm table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <t t-foreach="state.columns" t-as="column" t-key="column">
                                <th class="text-end"><t t-esc="column"/></th>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="state.lines" t-as="line" t-key="line.name">
                            <ReportLineComponent line="line" onLineClick="onLineClick"/>
                        </t>
                    </tbody>
                </table>
            </div>
        </div>
    </t>

</templates>
