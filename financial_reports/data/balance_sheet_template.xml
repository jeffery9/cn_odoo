        <record id="account_financial_report_balance_sheet_payable_expr" model="account.report.expression">
            <field name="report_line_id" ref="account_financial_report_balance_sheet_accounts_payable"/>
            <field name="name">Payable</field>
            <field name="expression_type">account_type</field>
            <field name="account_type">liability_payable</field>
        </record>

        <record id="account_financial_report_balance_sheet_other_current_liabilities" model="account.report.line">
            <field name="report_id" ref="account_financial_report_balance_sheet"/>
            <field name="name">Other Current Liabilities</field>
            <field name="sequence">20</field>
            <field name="level">2</field>
            <field name="parent_id" ref="account_financial_report_balance_sheet_current_liabilities"/>
        </record>
        <record id="account_financial_report_balance_sheet_other_current_liabilities_expr" model="account.report.expression">
            <field name="report_line_id" ref="account_financial_report_balance_sheet_other_current_liabilities"/>
            <field name="name">Other Current Liabilities</field>
            <field name="expression_type">account_type</field>
            <field name="account_type">liability_current</field>
        </record>

        <record id="account_financial_report_balance_sheet_non_current_liabilities" model="account.report.line">
            <field name="report_id" ref="account_financial_report_balance_sheet"/>
            <field name="name">Non-Current Liabilities</field>
            <field name="sequence">20</field>
            <field name="level">1</field>
            <field name="parent_id" ref="account_financial_report_balance_sheet_liabilities"/>
        </record>
        <record id="account_financial_report_balance_sheet_non_current_liabilities_expr" model="account.report.expression">
            <field name="report_line_id" ref="account_financial_report_balance_sheet_non_current_liabilities"/>
            <field name="name">Non-Current Liabilities</field>
            <field name="expression_type">account_type</field>
            <field name="account_type">liability_non_current</field>
        </record>

        <!-- Equity -->
        <record id="account_financial_report_balance_sheet_equity" model="account.report.line">
            <field name="report_id" ref="account_financial_report_balance_sheet"/>
            <field name="name">Equity</field>
            <field name="sequence">30</field>
            <field name="level">0</field>
        </record>

        <record id="account_financial_report_balance_sheet_owners_equity" model="account.report.line">
            <field name="report_id" ref="account_financial_report_balance_sheet"/>
            <field name="name">Owner&apos;s Equity</field>
            <field name="sequence">10</field>
            <field name="level">1</field>
            <field name="parent_id" ref="account_financial_report_balance_sheet_equity"/>
        </record>
        <record id="account_financial_report_balance_sheet_equity_expr" model="account.report.expression">
            <field name="report_line_id" ref="account_financial_report_balance_sheet_owners_equity"/>
            <field name="name">Equity</field>
            <field name="expression_type">account_type</field>
            <field name="account_type">equity</field>
        </record>

        <record id="account_financial_report_balance_sheet_retained_earnings" model="account.report.line">
            <field name="report_id" ref="account_financial_report_balance_sheet"/>
            <field name="name">Retained Earnings</field>
            <field name="sequence">20</field>
            <field name="level">1</field>
            <field name="parent_id" ref="account_financial_report_balance_sheet_equity"/>
        </record>
        <record id="account_financial_report_balance_sheet_retained_earnings_expr" model="account.report.expression">
            <field name="report_line_id" ref="account_financial_report_balance_sheet_retained_earnings"/>
            <field name="name">Retained Earnings</field>
            <field name="expression_type">account_type</field>
            <field name="account_type">equity_unaffected</field>
        </record>
    </data>
</odoo>
