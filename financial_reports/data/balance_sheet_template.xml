            <field name="sequence">30</field>
            <field name="level">2</field>
            <field name="parent_id" ref="account_financial_report_balance_sheet_current_assets"/>
        </record>
        <record id="account_financial_report_balance_sheet_other_current_assets_expr" model="account.report.expression">
            <field name="report_line_id" ref="account_financial_report_balance_sheet_other_current_assets"/>
            <field name="name">Other Current Assets</field>
            <field name="expression_type">account_type</field>
            <field name="account_type">asset_current</field>
        </record>

        <record id="account_financial_report_balance_sheet_non_current_assets" model="account.report.line">
            <field name="report_id" ref="account_financial_report_balance_sheet"/>
            <field name="name">Non-Current Assets</field>
            <field name="sequence">20</field>
            <field name="level">1</field>
            <field name="parent_id" ref="account_financial_report_balance_sheet_assets"/>
        </record>
        <record id="account_financial_report_balance_sheet_non_current_assets_expr" model="account.report.expression">
            <field name="report_line_id" ref="account_financial_report_balance_sheet_non_current_assets"/>
            <field name="name">Non-Current Assets</field>
            <field name="expression_type">account_type</field>
            <field name="account_type">asset_non_current</field>
        </record>

        <!-- Liabilities -->
        <record id="account_financial_report_balance_sheet_liabilities" model="account.report.line">
            <field name="report_id" ref="account_financial_report_balance_sheet"/>
            <field name="name">Liabilities</field>
            <field name="sequence">20</field>
            <field name="level">0</field>
        </record>

        <record id="account_financial_report_balance_sheet_current_liabilities" model="account.report.line">
            <field name="report_id" ref="account_financial_report_balance_sheet"/>
            <field name="name">Current Liabilities</field>
            <field name="sequence">10</field>
            <field name="level">1</field>
            <field name="parent_id" ref="account_financial_report_balance_sheet_liabilities"/>
        </record>

        <record id="account_financial_report_balance_sheet_accounts_payable" model="account.report.line">
            <field name="report_id" ref="account_financial_report_balance_sheet"/>
