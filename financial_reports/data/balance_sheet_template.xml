<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="account_financial_report_balance_sheet" model="account.report">
            <field name="name">Balance Sheet</field>
            <field name="report_type">balance_sheet</field>
            <field name="sequence">10</field>
        </record>

        <!-- Assets -->
        <record id="account_financial_report_balance_sheet_assets" model="account.report.line">
            <field name="report_id" ref="account_financial_report_balance_sheet"/>
            <field name="name">Assets</field>
            <field name="sequence">10</field>
            <field name="level">0</field>
        </record>

        <record id="account_financial_report_balance_sheet_current_assets" model="account.report.line">
            <field name="report_id" ref="account_financial_report_balance_sheet"/>
            <field name="name">Current Assets</field>
            <field name="sequence">10</field>
            <field name="level">1</field>
            <field name="parent_id" ref="account_financial_report_balance_sheet_assets"/>
        </record>

        <record id="account_financial_report_balance_sheet_cash_equivalents" model="account.report.line">
            <field name="report_id" ref="account_financial_report_balance_sheet"/>
            <field name="name">Cash and Cash Equivalents</field>
            <field name="sequence">10</field>
            <field name="level">2</field>
            <field name="parent_id" ref="account_financial_report_balance_sheet_current_assets"/>
        </record>
        <record id="account_financial_report_balance_sheet_cash_expr" model="account.report.expression">
            <field name="report_line_id" ref="account_financial_report_balance_sheet_cash_equivalents"/>
            <field name="name">Cash</field>
            <field name="expression_type">account_type</field>
            <field name="account_type">asset_cash</field>
        </record>

        <record id="account_financial_report_balance_sheet_accounts_receivable" model="account.report.line">
            <field name="report_id" ref="account_financial_report_balance_sheet"/>
            <field name="name">Accounts Receivable</field>
            <field name="sequence">20</field>
            <field name="level">2</field>
            <field name="parent_id" ref="account_financial_report_balance_sheet_current_assets"/>
        </record>
        <record id="account_financial_report_balance_sheet_receivable_expr" model="account.report.expression">
            <field name="report_line_id" ref="account_financial_report_balance_sheet_accounts_receivable"/>
            <field name="name">Receivable</field>
            <field name="expression_type">account_type</field>
            <field name="account_type">asset_receivable</field>
        </record>

        <record id="account_financial_report_balance_sheet_other_current_assets" model="account.report.line">
            <field name="report_id" ref="account_financial_report_balance_sheet"/>
