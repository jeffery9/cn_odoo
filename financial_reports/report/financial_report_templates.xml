<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="financial_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2><t t-esc="doc['title']"/></h2>
                        <p>
                            <t t-if="doc['options']['periods']">
                                <t t-foreach="doc['options']['periods']" t-as="period" t-key="period.id">
                                    <t t-if="period.get('date_from')">From: <span t-esc="period['date_from']"/></t>
                                    <t t-if="period.get('date_to')">To: <span t-esc="period['date_to']"/></t>
                                    <br t-if="not isLast"/>
                                </t>
                            </t>
                        </p>
                        
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <t t-foreach="doc['columns']" t-as="column" t-key="column">
                                        <th class="text-end"><t t-esc="column"/></th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="_render_line">
                                    <t t-foreach="lines" t-as="line">
                                        <tr>
                                            <td>
                                                <span t-att-style="'padding-left: ' + (20 * (line.get('level', 0))) + 'px;'" t-esc="line['name']"/>
                                            </td>
                                            <t t-foreach="line['balances']" t-as="balance" t-key="$index">
                                                <td class="text-end">
                                                    <span t-esc="balance" t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
                                                </td>
                                            </t>
                                        </tr>
                                        <t t-if="line.get('children')">
                                            <t t-call="_render_line">
                                                <t t-set="lines" t-value="line.get('children')"/>
                                            </t>
                                        </t>
                                    </t>
                                </t>
                                <t t-call="_render_line">
                                    <t t-set="lines" t-value="doc['lines']"/>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>