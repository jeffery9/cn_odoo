<?xml version="1.0" encoding="utf-8"?>  
<odoo>  
    <record id="view_move_form_inherit_currency_refresh" model="ir.ui.view">  
        <field name="name">account.move.form.inherit.currency.refresh</field>  
        <field name="model">account.move</field>  
        <field name="inherit_id" ref="account.view_move_form"/>  
        <field name="arch" type="xml">  
            <xpath expr="//button[@name='action_post'][2]" position="after">  
                <button name="action_refresh_currency_rate"   
                        string="刷新汇率"   
                        type="object"   
                        class="btn-secondary"   
                        attrs="{'invisible': ['|', ('state', '!=', 'draft'), ('currency_id', '=', 'company_currency_id')]}"  
                        data-hotkey="r"/>  
            </xpath>  
            <xpath expr="//field[@name='invoice_currency_rate']" position="after">  
                <field name="inverse_currency_rate" digits="[12,6]" readonly="True"/>  
            </xpath>  
        </field>  
    </record>  
</odoo>