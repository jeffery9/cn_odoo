        <field name="property_cost_method">average</field>  
    </record>  

    <!-- Landed Cost Categories -->
    <record id="product_category_landed_cost" model="product.category">  
        <field name="name">到岸成本类</field>  
        <field name="property_cost_method">average</field>  
    </record>  

