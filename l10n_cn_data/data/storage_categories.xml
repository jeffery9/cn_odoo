    <record id="storage_category_medium_freq_small" model="stock.storage.category">  
        <field name="name">中频率 - 小型</field>  
        <field name="allow_new_product">mixed</field>  
        <field name="max_weight">200.00</field>  
    </record>  
  
    <record id="storage_category_low_freq_large" model="stock.storage.category">  
        <field name="name">低频率 - 大型</field>  
        <field name="allow_new_product">mixed</field>  
