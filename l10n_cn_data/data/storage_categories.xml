<?xml version="1.0" encoding="utf-8"?>  
<odoo>  
    <!-- 中国本地化仓储类别 - 按使用频率和大小分类 -->  
    <record id="storage_category_high_freq_large" model="stock.storage.category">  
        <field name="name">高频率 - 大型</field>  
        <field name="allow_new_product">mixed</field>  
        <field name="max_weight">3000.00</field>  
    </record>  
  
    <record id="storage_category_high_freq_small" model="stock.storage.category">  
        <field name="name">高频率 - 小型</field>  
