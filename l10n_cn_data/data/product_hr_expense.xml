<?xml version="1.0" encoding="utf-8"?>  
<odoo>  
    <!-- 中国本地化常用费用报销产品 -->  
    <record id="expense_product_travel" model="product.product">  
        <field name="name">差旅费</field>  
        <field name="description">包括交通费、住宿费等出差相关费用</field>  
        <field name="standard_price">0.0</field>  
        <field name="type">service</field>  
        <field name="uom_id" ref="uom.product_uom_unit"/>  
        <field name="uom_po_id" ref="uom.product_uom_unit"/>  
        <field name="default_code">TRAVEL</field>  
        <field name="can_be_expensed" eval="True"/>  
        <field name="sale_ok" eval="False"/>  
        <field name="purchase_ok" eval="False"/>  
        <field name="categ_id" ref="product.cat_expense"/>
    </record>  
  
