            <domain_force>['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</domain_force>
        </record>

        <record id="cn_outsourcing_blacklist_company_rule" model="ir.rule">
            <name>Outsourcing Blacklist Multi-Company Rule</name>
