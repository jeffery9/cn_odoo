<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-Company Rules -->
        <record id="cn_outsourcing_contract_company_rule" model="ir.rule">
            <field name="name">Outsourcing Contract Multi-Company Rule</field>
            <field name="model_id" ref="model_cn_outsourcing_contract"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="cn_outsourcing_assignment_company_rule" model="ir.rule">
            <field name="name">Outsourcing Assignment Multi-Company Rule</field>
            <field name="model_id" ref="model_cn_outsourcing_assignment"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="cn_outsourcing_settlement_company_rule" model="ir.rule">
            <field name="name">Outsourcing Settlement Multi-Company Rule</field>
            <field name="model_id" ref="model_cn_outsourcing_settlement"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="cn_outsourcing_blacklist_company_rule" model="ir.rule">
            <field name="name">Outsourcing Blacklist Multi-Company Rule</field>
            <field name="model_id" ref="model_cn_outsourcing_blacklist"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
